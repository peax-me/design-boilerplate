{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test*)",
      "Bash(pnpm build)",
      "Bash(pnpm knip)",
      "Bash(pnpm adr:check)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(avifenc *)",
      "Bash(cwebp *)",
      "Bash(blender -b -P assets/3d/source/scripts/*)",
      "Bash(pnpm --filter @repo/web lighthouse)",
      "Bash(pnpm --filter @repo/web build)",
      "Bash(pnpm --filter @repo/web start*)",
      "Bash(pnpm --filter @repo/web exec playwright test*)",
      "Bash(curl -sf http://localhost:3000/*)",
      "Bash(curl -sf http://localhost:3100/*)",
      "Bash(jq *)",
      "mcp__magnific",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "mcp__blender"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "mcp__magnific__trash_purge",
      "mcp__magnific__creations_trash",
      "mcp__magnific__folders_delete",
      "mcp__magnific__library_delete",
      "mcp__magnific__comments_delete",
      "mcp__magnific__tags_delete",
      "mcp__magnific__brand_kit_delete_template",
      "mcp__magnific__spaces_delete_node",
      "mcp__magnific__spaces_delete_page",
      "mcp__magnific__spaces_delete_connection",
      "mcp__magnific__spaces_purge_page",
      "mcp__magnific__projects_share",
      "mcp__magnific__projects_share_role",
      "mcp__magnific__projects_unshare",
      "mcp__magnific__projects_share_leave",
      "mcp__magnific__spaces_share_update",
      "mcp__magnific__spaces_share_invite_link",
      "mcp__magnific__library_share",
      "mcp__magnific__flows_share",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_drop",
      "mcp__chrome-devtools__upload_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/src/hooks/guard-adr-status.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/src/hooks/check-edited-file.ts\""
          }
        ]
      }
    ]
  }
}
