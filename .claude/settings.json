{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test*)",
      "Bash(pnpm build)",
      "Bash(pnpm knip)",
      "Bash(pnpm adr:check)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(avifenc *)",
      "Bash(cwebp *)",
      "Bash(blender -b *)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm --filter @repo/web lighthouse)",
      "Bash(pnpm --filter @repo/web build)",
      "Bash(pnpm --filter @repo/web start*)",
      "Bash(pnpm --filter @repo/web exec playwright test*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(jq *)",
      "mcp__magnific",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "mcp__blender"
    ],
    "deny": ["Bash(git push --force*)", "Bash(git reset --hard*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/src/hooks/guard-adr-status.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/src/hooks/check-edited-file.ts\""
          }
        ]
      }
    ]
  }
}
